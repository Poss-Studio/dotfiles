order += "battery all"
order +=  "read_file light"
order += "volume master"
order += "tztime local"
general {
	color_good = "#a6da95"
        color_bad  = "#ed8796"
	color_degraded = "#afb4db" 
    separator = "" 
       colors = true
        interval = 1
}
read_file light {
	#format = "%title: %content"
	format = "[󰌵:%content]"
	path = "/sys/class/backlight/intel_backlight/brightness"
#	Max_characters = 100
}
ethernet _first_ {
        format_up = "E: %ip (%speed)"
        format_down = "E: down"
}
battery all {
        format = "[%status:%percentage]"
        format_down = "No battery"
        status_chr = "󰂄"
        status_bat = "󰁹"
        status_unk = "󰂃"
        status_full = "󱟢"
        path = "/sys/class/power_supply/BAT%d/uevent"
        low_threshold = 10
        threshold_type = "percentage"
}
tztime local {
        format = "[󰔠 %Y-%m-%d󱑂 %H:%M]"
}
volume master {
	format = "[ :%volume]"
	format_muted = "[ ]"
	device = "default"
	mixer = "Master"
	mixer_idx = 0
}
